# Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database Configuration (Docker local default)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_orders?schema=public

# Redis Configuration (Docker local default)
REDIS_URL=redis://localhost:6379

# Authentication & JWT Configuration
# In production, JWT_SECRET must be a cryptographically strong secret >= 32 characters
JWT_SECRET=dev_jwt_secret_change_me_in_production_min32chars!
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=14
REFRESH_TOKEN_COOKIE_NAME=refreshToken
# COOKIE_DOMAIN=example.com
